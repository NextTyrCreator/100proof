{
  "name": "100proof",
  "private": true,
  "version": "0.0.0",
  "description": "90-second walkthrough → verifiable, insurance-grade home inventory. Meta Global AI Developer Hackathon 2026.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "deadcode": "knip",
    "licenses": "pnpm licenses list --json > .licenses.json && node scripts/check-licenses.mjs",
    "perf:measure": "bash scripts/perf/measure.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "knip": "^5.33.0",
    "typescript": "^5.6.3"
  }
}
